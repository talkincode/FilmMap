{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talkincode.github.io/FilmMap/schemas/profile.schema.json",
  "title": "FilmMap Capability Profile",
  "type": "object",
  "required": ["schema_version", "profile_id", "generated_at_unix_ms", "capabilities"],
  "properties": {
    "schema_version": {"const": "filmmap/profile/v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "description": "Legacy display timestamp; use generated_at_unix_ms for ordering."},
    "generated_at_unix_ms": {"type": "integer", "minimum": 0},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["available", "unavailable", "unverified", "failed"]},
          "provider": {"type": "string"},
          "executable": {"type": "string"},
          "version": {"type": "string"},
          "note": {"type": "string"},
          "external_processing": {"type": ["boolean", "null"]},
          "precision": {"type": "object", "properties": {"max_error_ms": {"type": "number", "minimum": 0}, "unit": {"type": "string"}}, "additionalProperties": true}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "available"}}}, "then": {"anyOf": [{"required": ["provider"]}, {"required": ["executable"]}]}},
          {"if": {"properties": {"status": {"const": "unavailable"}}}, "then": {"required": ["note"]}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
